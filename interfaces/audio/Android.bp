aidl_interface {
    name: "vendor.mediatek.hardware.audio",
    system_ext_specific: true,
    vendor_available: true,
    srcs: ["vendor/mediatek/hardware/audio/*.aidl"],
    stability: "vintf",
    owner: "mediatek",

    backend: {
        cpp: {
            enabled: true,
        },
        java: {
            sdk_version: "module_current",
        },
    },
    versions_with_info: [
        {
            version: "1",
            imports: [],
        },
    ],
}
