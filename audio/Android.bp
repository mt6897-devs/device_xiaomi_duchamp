cc_binary {
    name: "android.hardware.audio.service.mediatek",

    init_rc: ["android.hardware.audio.service.mediatek.rc"],
    relative_install_path: "hw",
    vendor: true,

    srcs: ["service.cpp"],

    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],

    shared_libs: [
        "libcutils",
        "libbinder",
        "libbinder_ndk",
        "libhidlbase",
        "liblog",
        "libutils",
        "libhardware",
        "android.hardware.soundtrigger3-impl",
        "android.hardware.soundtrigger3-V3-ndk",
        "vendor.mediatek.hardware.audio-impl",
        "vendor.mediatek.hardware.audio-V1-ndk",
    ],
}

cc_library_shared {
    name: "android.hardware.soundtrigger3-impl",
    relative_install_path: "hw",
    soc_specific: true,
}

cc_library_shared {
    name: "vendor.mediatek.hardware.audio-impl",
    relative_install_path: "hw",
    soc_specific: true,
}
